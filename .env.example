# ==============================================================================
# MOODLIFY - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Renombrar este archivo a .env o definir estas variables en Vercel / hosting.
# Nota: Al ser una aplicación cliente SPA, las variables usadas en js/config.js 
# se configuran directamente en dicho archivo o se inyectan en tiempo de build.

# Entorno: 'development' | 'staging' | 'production'
VITE_ENV=production

# URL del backend (Google Apps Script Web App o API REST Node.js/Supabase)
# Dejar vacío ('') para utilizar automáticamente el modo de demostración con Mocks
VITE_API_URL=https://script.google.com/macros/s/AKfycbx_TU_SCRIPT_ID_AQUI/exec

# Clave secreta para validación de Webhooks salientes (HMAC-SHA256)
MOODLIFY_WEBHOOK_SECRET=your_super_secret_webhook_signing_key_32_chars

# Configuración de Sentry (Monitoreo de errores en producción - Opcional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Rate Limiting y Timeouts cliente (milisegundos)
API_TIMEOUT_MS=30000
API_MAX_RETRIES=3

# Moodle Web Service Default Configuration
MOODLE_RATE_LIMIT_RPS=10

